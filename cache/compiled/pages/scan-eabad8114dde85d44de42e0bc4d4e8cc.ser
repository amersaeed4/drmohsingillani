a:3:{s:7:"headers";a:24:{s:34:"28e638e8f6754be1bf45be86f76b5eecsc";a:6:{s:5:"title";s:7:"Contact";s:6:"routes";a:1:{s:7:"default";s:8:"/contact";}s:4:"lead";s:100:"We'd love to hear from you. Call, write or send a message and our team will get back to you shortly.";s:10:"form_title";s:12:"Get in touch";s:8:"metadata";a:1:{s:11:"description";s:151:"Contact Prof. Dr. Mohsin Gillani in Johar Town, Lahore. Call 042 35174502, email drmohsingillani@gmail.com or send us a message to book an appointment.";}s:4:"form";a:4:{s:4:"name";s:7:"contact";s:6:"fields";a:5:{s:4:"name";a:5:{s:5:"label";s:9:"Full name";s:11:"placeholder";s:9:"Full name";s:4:"type";s:4:"text";s:12:"autocomplete";s:4:"name";s:8:"validate";a:1:{s:8:"required";b:1;}}s:5:"phone";a:5:{s:5:"label";s:5:"Phone";s:11:"placeholder";s:5:"Phone";s:4:"type";s:3:"tel";s:12:"autocomplete";s:3:"tel";s:8:"validate";a:1:{s:8:"required";b:1;}}s:5:"email";a:5:{s:5:"label";s:5:"Email";s:11:"placeholder";s:14:"E-mail address";s:4:"type";s:5:"email";s:12:"autocomplete";s:5:"email";s:8:"validate";a:1:{s:8:"required";b:1;}}s:7:"message";a:4:{s:5:"label";s:7:"Message";s:11:"placeholder";s:15:"Your message...";s:4:"type";s:8:"textarea";s:4:"rows";i:5;}s:8:"honeypot";a:1:{s:4:"type";s:8:"honeypot";}}s:7:"buttons";a:1:{s:6:"submit";a:2:{s:4:"type";s:6:"submit";s:5:"value";s:14:"Send a message";}}s:7:"process";a:4:{i:0;a:1:{s:4:"save";a:4:{s:10:"fileprefix";s:8:"enquiry-";s:10:"dateformat";s:9:"Ymd-His-u";s:9:"extension";s:3:"txt";s:4:"body";s:35:"{% include 'forms/data.txt.twig' %}";}}i:1;a:1:{s:5:"email";a:3:{s:7:"subject";s:41:"[Website enquiry] {{ form.value.name|e }}";s:4:"body";s:36:"{% include 'forms/data.html.twig' %}";s:8:"reply_to";s:22:"{{ form.value.email }}";}}i:2;a:1:{s:7:"message";s:74:"Thank you! Your message has been sent and we will get back to you shortly.";}i:3;a:1:{s:5:"reset";b:1;}}}}s:34:"f9196b6d29999cdf38e6a59bd07e4a5fsc";a:5:{s:5:"title";s:8:"Diabetes";s:6:"routes";a:1:{s:7:"default";s:9:"/diabetes";}s:4:"lead";s:66:"Learn about diabetes and explore management and treatment options.";s:8:"metadata";a:1:{s:11:"description";s:149:"Diabetes care in Lahore: understand the types of diabetes, how it is managed and treated, including metabolic surgery, with Prof. Dr. Mohsin Gillani.";}s:10:"card_image";s:18:"New-Project-40.jpg";}s:34:"060ab59161cfa3a5e1f3e96fc4cf32f4sc";a:4:{s:5:"title";s:19:"Diabetes Management";s:6:"routes";a:1:{s:7:"default";s:20:"/management-diabetes";}s:4:"lead";s:100:"Surgical, medical and non-surgical approaches to managing diabetes and preventing its complications.";s:8:"metadata";a:1:{s:11:"description";s:150:"Diabetes management in Lahore: surgical, medical and non-surgical options, treating complications with therapies and devices, and preventing diabetes.";}}s:34:"f9f75ba3d7ff7ca6f5d563ac271bd76fsc";a:5:{s:5:"title";s:18:"Diabetes Treatment";s:6:"routes";a:1:{s:7:"default";s:19:"/diabetes-treatment";}s:4:"lead";s:58:"Advanced therapies for diabetic foot and neuropathic pain.";s:8:"metadata";a:1:{s:11:"description";s:157:"Diabetes treatment in Lahore: diabetic foot care with hyperbaric oxygen, Dermapace and VAC dressing, plus neuropathic pain therapies such as Nerve Scrambler.";}s:13:"show_children";b:1;}s:34:"81eebb017ddb0e19d109b3d8bb67e925sc";a:4:{s:5:"title";s:15:"Type-2 Diabetes";s:6:"routes";a:1:{s:7:"default";s:16:"/type-2-diabetes";}s:4:"lead";s:104:"The role of metabolic surgery in type-2 diabetes mellitus, with its complications and treatment options.";s:8:"metadata";a:1:{s:11:"description";s:152:"Type-2 diabetes in Lahore: causes, complications, why to treat it, and how bariatric/metabolic surgery can help. Guidance from Prof. Dr. Mohsin Gillani.";}}s:34:"cc18b45911cb2eaf4b6c38a05a4d07ecsc";a:5:{s:5:"title";s:14:"About Diabetes";s:6:"routes";a:1:{s:7:"default";s:15:"/about-diabetes";}s:4:"lead";s:91:"A group of metabolic diseases characterised by raised blood glucose levels (hyperglycemia).";s:8:"metadata";a:1:{s:11:"description";s:149:"What is diabetes? Understand Type-1, Type-2, gestational diabetes and LADA, their causes, treatment and prevention. Prof. Dr. Mohsin Gillani, Lahore.";}s:10:"card_image";s:18:"New-Project-40.jpg";}s:34:"ae5664e1f7011225f6efabd6a7e4577esc";a:6:{s:5:"title";s:7:"Sitemap";s:7:"visible";b:0;s:6:"routes";a:1:{s:7:"default";s:8:"/sitemap";}s:7:"sitemap";a:1:{s:6:"ignore";b:1;}s:3:"seo";a:1:{s:7:"noindex";b:0;}s:8:"metadata";a:1:{s:11:"description";s:61:"A list of every page on the Prof. Dr. Mohsin Gillani website.";}}s:34:"0e0ad1dc7ba3f8ee109acaf22fec4dfdsc";a:6:{s:5:"title";s:5:"About";s:6:"routes";a:1:{s:7:"default";s:6:"/about";}s:4:"lead";s:110:"Our vision is to treat obesity and diabetes along with their complications, and to prevent them in the future.";s:8:"metadata";a:1:{s:11:"description";s:129:"Meet Prof. Dr. Mohsin Gillani's clinic in Lahore: our vision, mission and personalized approach to treating obesity and diabetes.";}s:10:"hero_image";s:24:"bedoctor-home-pic2-1.png";s:8:"hero_alt";s:27:"Prof. Doctor Mohsin Gillani";}s:34:"fc60ddab2872bf869434745855603281sc";a:6:{s:5:"title";s:8:"Our Team";s:6:"routes";a:1:{s:7:"default";s:8:"/doctors";}s:7:"visible";b:0;s:4:"lead";s:70:"Meet the professional team behind Prof. Dr. Mohsin Gillani’s clinic.";s:8:"metadata";a:1:{s:11:"description";s:157:"Meet the doctors, surgeons, specialists and support staff at Prof. Dr. Mohsin Gillani's obesity, diabetes and advanced laparoscopic surgery clinic in Lahore.";}s:6:"groups";a:2:{i:0;a:2:{s:5:"title";s:10:"Management";s:7:"members";a:6:{i:0;a:3:{s:4:"name";s:21:"Ayeza Akhtar Randhawa";s:4:"role";s:9:"President";s:5:"photo";s:0:"";}i:1;a:3:{s:4:"name";s:32:"Prof Dr. Muhammad Mohsin Gillani";s:4:"role";s:3:"CEO";s:5:"photo";s:0:"";}i:2;a:3:{s:4:"name";s:13:"Naleem Mohsin";s:4:"role";s:8:"Director";s:5:"photo";s:0:"";}i:3;a:3:{s:4:"name";s:13:"Batool Fatima";s:4:"role";s:8:"Director";s:5:"photo";s:0:"";}i:4;a:3:{s:4:"name";s:14:"Nafeesa Akhtar";s:4:"role";s:8:"Director";s:5:"photo";s:0:"";}i:5;a:3:{s:4:"name";s:10:"Amer Saeed";s:4:"role";s:14:"Marketing Head";s:5:"photo";s:0:"";}}}i:1;a:2:{s:5:"title";s:22:"Medical & support team";s:7:"members";a:16:{i:0;a:3:{s:4:"name";s:33:"Prof. Dr. Muhammad Mohsin Gillani";s:4:"role";s:40:"Advance Laparoscopic / Bariatric Surgeon";s:5:"photo";s:0:"";}i:1;a:3:{s:4:"name";s:17:"Dr. Salman Akhtar";s:4:"role";s:40:"Advance Laparoscopic / Bariatric Surgeon";s:5:"photo";s:0:"";}i:2;a:3:{s:4:"name";s:19:"Dr. Ghias Ul Hassan";s:4:"role";s:18:"Gastroenterologist";s:5:"photo";s:0:"";}i:3;a:3:{s:4:"name";s:14:"Dr. Sana Ullah";s:4:"role";s:9:"Urologist";s:5:"photo";s:0:"";}i:4;a:3:{s:4:"name";s:21:"Prof. Dr. Yahya Saeed";s:4:"role";s:25:"Anesthetist / Intensivist";s:5:"photo";s:0:"";}i:5;a:3:{s:4:"name";s:6:"Fatima";s:4:"role";s:24:"Dietitian / Nutritionist";s:5:"photo";s:0:"";}i:6;a:3:{s:4:"name";s:14:"Dr Javed Iqbal";s:4:"role";s:15:"Endocrinologist";s:5:"photo";s:0:"";}i:7;a:3:{s:4:"name";s:13:"Fatima Batool";s:4:"role";s:31:"Medical Assistant / Coordinator";s:5:"photo";s:0:"";}i:8;a:3:{s:4:"name";s:13:"Naleem Mohsin";s:4:"role";s:3:"H&T";s:5:"photo";s:0:"";}i:9;a:3:{s:4:"name";s:13:"Ayeza Randawa";s:4:"role";s:15:"Medical Tourism";s:5:"photo";s:0:"";}i:10;a:3:{s:4:"name";s:20:"Prof. Mohsin Gillani";s:4:"role";s:15:"Medical Tourism";s:5:"photo";s:0:"";}i:11;a:3:{s:4:"name";s:13:"Fatima Batool";s:4:"role";s:15:"Medical Tourism";s:5:"photo";s:0:"";}i:12;a:3:{s:4:"name";s:14:"Dr. Ahsan Riaz";s:4:"role";s:23:"Beauty & Body Reshaping";s:5:"photo";s:0:"";}i:13;a:3:{s:4:"name";s:12:"Arezo Kanani";s:4:"role";s:34:"Gastrosurgery & Urological Surgeon";s:5:"photo";s:0:"";}i:14;a:3:{s:4:"name";s:9:"Mona Khan";s:4:"role";s:16:"General Medicine";s:5:"photo";s:0:"";}i:15;a:3:{s:4:"name";s:14:"Nafeesa Akhtar";s:4:"role";s:12:"Neurosurgery";s:5:"photo";s:0:"";}}}}}s:34:"0dbe9bbd12df382a81261636a92e5db8sc";a:5:{s:5:"title";s:7:"Obesity";s:6:"routes";a:1:{s:7:"default";s:8:"/obesity";}s:4:"lead";s:87:"Understand obesity and explore management, non-surgical and surgical treatment options.";s:8:"metadata";a:1:{s:11:"description";s:153:"Obesity care in Lahore: learn about obesity, its management and treatment options, from diet changes to bariatric surgery, with Prof. Dr. Mohsin Gillani.";}s:10:"card_image";s:18:"New-Project-41.jpg";}s:34:"b54673de63834fa26cbf016ac4ccbf37sc";a:5:{s:5:"title";s:17:"Obesity Treatment";s:6:"routes";a:1:{s:7:"default";s:18:"/obesity-treatment";}s:4:"lead";s:101:"From diet and lifestyle modification to advanced procedures, find the treatment that fits your needs.";s:8:"metadata";a:1:{s:11:"description";s:158:"Obesity treatment options in Lahore: diet and lifestyle modification, Plenity capsule, gastric balloon, laser liposuction, weight-loss injections and tablets.";}s:13:"show_children";b:1;}s:34:"77f6be44e6d27e9171b0c89f9ea5c8aesc";a:4:{s:5:"title";s:21:"Non-Surgical Approach";s:6:"routes";a:1:{s:7:"default";s:22:"/non-surgical-approach";}s:4:"lead";s:81:"Diet, exercise and medication: how weight can be controlled without an operation.";s:8:"metadata";a:1:{s:11:"description";s:145:"Non-surgical weight-loss approaches in Lahore: adjustment diets, regular physical exercise and medication, explained by Prof. Dr. Mohsin Gillani.";}}s:34:"9d2689be8eef07f8f2828286b67783dbsc";a:5:{s:5:"title";s:17:"Surgical Approach";s:6:"routes";a:1:{s:7:"default";s:18:"/surgical-approach";}s:4:"lead";s:117:"Many studies show that a surgical intervention offers the highest chance of success for patients with morbid obesity.";s:8:"metadata";a:1:{s:11:"description";s:146:"Weight-loss (bariatric) surgery in Lahore offers the highest chance of lasting success for morbid obesity. Explore the types of surgery available.";}s:13:"show_children";b:1;}s:34:"9ff4ed197744872734827a147509b6edsc";a:4:{s:5:"title";s:19:"Mini-Gastric Bypass";s:6:"routes";a:1:{s:7:"default";s:20:"/mini-gastric-bypass";}s:4:"lead";s:115:"The Omega Loop (single anastomosis) gastric bypass combines restriction and malabsorption, and is fully reversible.";s:8:"metadata";a:1:{s:11:"description";s:140:"Mini-gastric bypass (Omega Loop / single anastomosis) in Lahore: a reversible weight-loss operation combining restriction and malabsorption.";}}s:34:"7e980a1c6f92b0e979c2984494056a14sc";a:4:{s:5:"title";s:21:"Endoscopic Ballooning";s:6:"routes";a:1:{s:7:"default";s:22:"/endoscopic-ballooning";}s:4:"lead";s:93:"A temporary, reversible gastric balloon placed through endoscopy, with no surgical incisions.";s:8:"metadata";a:1:{s:11:"description";s:157:"Endoscopic gastric balloon in Lahore: a temporary, reversible, incision-free procedure that creates early fullness and helps weight loss. Learn how it works.";}}s:34:"b2838bfaaa17929fe5cdef74b539c7a1sc";a:4:{s:5:"title";s:11:"Restrictive";s:6:"routes";a:1:{s:7:"default";s:12:"/restrictive";}s:4:"lead";s:81:"Laparoscopic sleeve gastrectomy, the most commonly performed weight-loss surgery.";s:8:"metadata";a:1:{s:11:"description";s:142:"Laparoscopic sleeve gastrectomy in Lahore: the most common bariatric surgery, removing 60-85% of the stomach to reduce hunger and food intake.";}}s:34:"b19625ef3a60b11bf910345f055b176dsc";a:4:{s:5:"title";s:15:"Gastric Banding";s:6:"routes";a:1:{s:7:"default";s:16:"/gastric-banding";}s:4:"lead";s:90:"An adjustable silicone band placed around the upper stomach to limit how much you can eat.";s:8:"metadata";a:1:{s:11:"description";s:146:"Adjustable gastric banding (lap band) in Lahore: how it works, expected loss of 50-60% of excess weight, and the possible risks and complications.";}}s:34:"ba7e2632c6adfd4ea15ba6b606d0ff30sc";a:4:{s:5:"title";s:24:"Roux-En-Y Gastric Bypass";s:6:"routes";a:1:{s:7:"default";s:25:"/roux-en-y-gastric-bypass";}s:4:"lead";s:96:"Considered the gold standard of modern obesity surgery, combining restriction and malabsorption.";s:8:"metadata";a:1:{s:11:"description";s:149:"Laparoscopic Roux-En-Y gastric bypass in Lahore, the gold standard of obesity surgery: how it works, what happens during surgery, and what to expect.";}}s:34:"800e2980be458e3644e716b74768052csc";a:4:{s:5:"title";s:18:"Obesity Management";s:6:"routes";a:1:{s:7:"default";s:19:"/obesity-management";}s:4:"lead";s:101:"Surgical, medical and non-surgical options to manage obesity, treat its complications and prevent it.";s:8:"metadata";a:1:{s:11:"description";s:134:"Comprehensive obesity management in Lahore: surgical, medical and device-based options, treating complications and preventing obesity.";}}s:34:"331d3fae13f6e833f9cffc82c1810c1esc";a:5:{s:5:"title";s:13:"About Obesity";s:6:"routes";a:1:{s:7:"default";s:14:"/about-obesity";}s:4:"lead";s:118:"Obesity is a chronic and severe condition of overweight. Here is how it is measured and what it means for your health.";s:8:"metadata";a:1:{s:11:"description";s:154:"What is obesity? Learn how BMI is measured, what morbid obesity means and its physical and psychological health effects. Prof. Dr. Mohsin Gillani, Lahore.";}s:10:"card_image";s:18:"New-Project-41.jpg";}s:34:"3761d343376f8ea94dd4dfbb16b6ed82sc";a:7:{s:5:"title";s:4:"Home";s:4:"menu";s:4:"Home";s:8:"metadata";a:1:{s:11:"description";s:150:"Prof. Dr. Mohsin Gillani: advanced laparoscopic, bariatric (obesity) and diabetes surgeon in Lahore with 25+ years of experience. Book an appointment.";}s:4:"hero";a:10:{s:7:"eyebrow";s:37:"Bariatric · Laparoscopic · Diabetes";s:5:"title";s:63:"Hi, I'm Prof. Doctor Mohsin Gillani with 25 years of experience";s:4:"text";s:95:"Consultant advanced laparoscopic, bariatric (obesity) and metabolic diabetes surgeon in Lahore.";s:12:"button_label";s:19:"Book an appointment";s:11:"button_link";s:8:"/contact";s:13:"button2_label";s:16:"About the clinic";s:12:"button2_link";s:6:"/about";s:5:"image";s:15:"baner-image.png";s:9:"image_alt";s:82:"Prof. Doctor Mohsin Gillani, advanced laparoscopic and bariatric surgeon in Lahore";s:5:"stats";a:2:{i:0;a:2:{s:5:"value";s:3:"25+";s:5:"label";s:30:"Years of experience in surgery";}i:1;a:2:{s:5:"value";s:5:"ALCOS";s:5:"label";s:30:"Director, Iqra Medical Complex";}}}s:5:"quote";a:3:{s:5:"image";s:24:"bedoctor-home-pic2-1.png";s:4:"text";s:170:"My passion is to transfer basic surgical, basic laparoscopic and advanced laparoscopic skills to the upcoming / future surgeons in the form of hands-on surgical training.";s:4:"name";s:31:"Professor Doctor Mohsin Gillani";}s:8:"services";a:4:{s:7:"eyebrow";s:8:"Services";s:5:"title";s:18:"My specializations";s:4:"text";s:61:"I have more than 25 years experience in the field of surgery.";s:5:"items";a:3:{i:0;a:5:{s:5:"title";s:32:"Consultant Advanced Laparoscopic";s:4:"text";s:149:"The only specialist center in Lahore providing personalized weight management solutions along with cancer and other advanced laparoscopic procedures.";s:5:"image";s:18:"New-Project-39.jpg";s:4:"link";s:6:"/alcos";s:10:"link_label";s:8:"See more";}i:1;a:5:{s:5:"title";s:18:"Metabolic Diabetes";s:4:"text";s:189:"It is a group of metabolic diseases characterized by increased levels of glucose in the blood (hyperglycemia), resulting from defects in either or both Insulin production or Insulin action.";s:5:"image";s:18:"New-Project-40.jpg";s:4:"link";s:15:"/about-diabetes";s:10:"link_label";s:8:"See more";}i:2;a:5:{s:5:"title";s:27:"Bariatric (Obesity) Surgeon";s:4:"text";s:177:"Obesity is a chronic and severe condition of overweight. It can be caused by a number of elements. The international standard for measuring obesity is the BMI (Body Mass Index).";s:5:"image";s:18:"New-Project-41.jpg";s:4:"link";s:14:"/about-obesity";s:10:"link_label";s:8:"See more";}}}s:3:"why";a:2:{s:5:"title";s:25:"Why you should choose me?";s:5:"items";a:3:{i:0;a:1:{s:4:"text";s:61:"I have more than 25 years experience in the field of surgery.";}i:1;a:1:{s:4:"text";s:103:"CEO of Scandinavian Obesity and Diabetes Clinic at Omar Hospital and Cardiac Centre Johar Town, Lahore.";}i:2;a:1:{s:4:"text";s:102:"Director of advanced laparoscopic, cancer and obesity surgery (ALCOS) at Iqra Medical Complex, Lahore.";}}}}s:34:"7c64a7e47e3e247aa29c3d9ae4dc1f89sc";a:4:{s:5:"title";s:13:"Medi Wellness";s:6:"routes";a:1:{s:7:"default";s:14:"/medi-wellness";}s:4:"lead";s:81:"Support for diabetic and obese patients, and for preventing diabetes and obesity.";s:8:"metadata";a:1:{s:11:"description";s:156:"Medi Wellness in Lahore: health and taste food services, fitness and yoga, and beauty and body reshaping for diabetic and obese patients and for prevention.";}}s:34:"10ff82737753cd1a6c5ab68a062d2a7bsc";a:5:{s:5:"title";s:5:"ALCOS";s:6:"routes";a:1:{s:7:"default";s:6:"/alcos";}s:4:"lead";s:97:"Advanced Laparoscopic Cancer & Obesity Surgery: the only specialist centre of its kind in Lahore.";s:8:"metadata";a:1:{s:11:"description";s:145:"ALCOS, the Advanced Laparoscopic Cancer & Obesity Surgery centre in Lahore: laparoscopic, cancer and obesity surgery by a multidisciplinary team.";}s:10:"card_image";s:18:"New-Project-39.jpg";}s:34:"0acb1c2a6330e73a8009f9b75374c2a2sc";a:4:{s:5:"title";s:29:"Advanced Laparoscopic Surgery";s:6:"routes";a:1:{s:7:"default";s:30:"/advanced-laparoscopic-surgery";}s:4:"lead";s:83:"Minimally invasive surgery with smaller incisions, less pain and a faster recovery.";s:8:"metadata";a:1:{s:11:"description";s:143:"Advanced laparoscopic (keyhole) surgery in Lahore: cholecystectomy, appendectomy, hernia repair, fundoplication and more, with faster recovery.";}}}s:5:"files";a:24:{s:66:"/Users/amer/Sites/drmohsingillani/user/pages/07.contact/contact.md";a:4:{i:0;i:1791797226;i:1;i:1443;i:2;s:34:"28e638e8f6754be1bf45be86f76b5eecsc";i:3;i:1791797229;}s:67:"/Users/amer/Sites/drmohsingillani/user/pages/04.diabetes/section.md";a:4:{i:0;i:1791796683;i:1;i:335;i:2;s:34:"f9196b6d29999cdf38e6a59bd07e4a5fsc";i:3;i:1791797229;}s:90:"/Users/amer/Sites/drmohsingillani/user/pages/04.diabetes/02.management-diabetes/default.md";a:4:{i:0;i:1791796683;i:1;i:548;i:2;s:34:"060ab59161cfa3a5e1f3e96fc4cf32f4sc";i:3;i:1791797229;}s:89:"/Users/amer/Sites/drmohsingillani/user/pages/