{# Inline SVG icons (stroke style). Usage: {{ m.icon('phone') }} #}
{% macro icon(name, size) %}
{%- set s = size|default(20) -%}
<svg class="icon icon-{{ name }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == 'phone' -%}<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>
{%- elseif name == 'mail' -%}<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>
{%- elseif name == 'pin' -%}<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>
{%- elseif name == 'clock' -%}<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
{%- elseif name == 'chevron' -%}<path d="m6 9 6 6 6-6"/>
{%- elseif name == 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- elseif name == 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
{%- elseif name == 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
{%- elseif name == 'check' -%}<path d="m20 6-11 11-5-5"/>
{%- elseif name == 'calendar' -%}<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
{%- elseif name == 'facebook' -%}<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
{%- elseif name == 'instagram' -%}<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/>
{%- elseif name == 'youtube' -%}<path d="M22.5 7.2a2.5 2.5 0 0 0-1.8-1.8C19.1 5 12 5 12 5s-7.1 0-8.7.4A2.5 2.5 0 0 0 1.5 7.2 26 26 0 0 0 1.1 12c0 1.6.1 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C4.9 19 12 19 12 19s7.1 0 8.7-.4a2.5 2.5 0 0 0 1.8-1.8c.3-1.6.4-3.2.4-4.8 0-1.6-.1-3.2-.4-4.8z"/><path d="m10 15 5-3-5-3z"/>
{%- elseif name == 'linkedin' -%}<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/>
{%- elseif name == 'pinterest' -%}<circle cx="12" cy="12" r="10"/><path d="M10.5 20.5 13 11M9 14c-1-3 .5-6 3.5-6 2.5 0 3.5 2 3 4s-2 3.5-3.5 3.5c-1 0-1.7-.6-2-1.5"/>
{%- elseif name == 'x' -%}<path d="M4 4l16 16M20 4 4 20"/>
{%- elseif name == 'cross' -%}<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/>
{%- endif -%}
</svg>
{%- endmacro %}

{# Recursive desktop navigation list #}
{% macro nav(items, depth) %}
{% import _self as m %}
{% set depth = depth|default(0) %}
<ul class="{{ depth == 0 ? 'nav-list' : 'sub-menu sub-' ~ depth }}"{% if depth > 0 %} role="menu"{% endif %}>
{% for p in items %}
    {% set kids = p.children.visible %}
    <li class="nav-item{{ kids|length ? ' has-children' : '' }}{{ p.active ? ' is-active' : '' }}{{ p.activeChild ? ' is-active-parent' : '' }}">
        <a href="{{ p.url }}"{% if p.active %} aria-current="page"{% endif %}>
            <span>{{ p.menu }}</span>
            {% if kids|length %}{{ m.icon('chevron', 14) }}{% endif %}
        </a>
        {% if kids|length %}{{ m.nav(kids, depth + 1) }}{% endif %}
    </li>
{% endfor %}
</ul>
{% endmacro %}

{# Recursive mobile navigation list (accordion) #}
{% macro mobile_nav(items, depth) %}
{% import _self as m %}
{% set depth = depth|default(0) %}
<ul class="m-list m-depth-{{ depth }}">
{% for p in items %}
    {% set kids = p.children.visible %}
    <li class="m-item{{ kids|length ? ' has-children' : '' }}{{ p.active or p.activeChild ? ' open' : '' }}">
        <div class="m-row">
            <a href="{{ p.url }}"{% if p.active %} aria-current="page"{% endif %}>{{ p.menu }}</a>
            {% if kids|length %}
            <button type="button" class="m-toggle" aria-expanded="{{ p.active or p.activeChild ? 'true' : 'false' }}" aria-label="Toggle {{ p.menu|e }} submenu">{{ m.icon('chevron', 18) }}</button>
            {% endif %}
        </div>
        {% if kids|length %}{{ m.mobile_nav(kids, depth + 1) }}{% endif %}
    </li>
{% endfor %}
</ul>
{% endmacro %}

{# Absolute URL for a local path or media url #}
{% macro abs(path) %}{{ url(path, true) }}{% endmacro %}

{# Recursive "in this section" tree; only expands the branch containing the current page #}
{% macro sidetree(items, current) %}
{% import _self as m %}
<ul>
{% for p in items %}
    <li class="{{ p.route == current.route ? 'is-current' : '' }}">
        <a href="{{ p.url }}"{% if p.route == current.route %} aria-current="page"{% endif %}>{{ p.menu }}</a>
        {% if (p.active or p.activeChild) and p.children.visible|length %}{{ m.sidetree(p.children.visible, current) }}{% endif %}
    </li>
{% endfor %}
</ul>
{% endmacro %}
